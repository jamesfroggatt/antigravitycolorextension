{
  "name": "workspace-identity",
  "displayName": "Workspace Identity",
  "description": "Colour-code each window — title bar, frame and editor grays — so you can tell workspaces apart at a glance. Works in Antigravity IDE and VS Code.",
  "version": "0.1.0",
  "publisher": "jamesfroggatt",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesfroggatt/antigravitycolorextension.git"
  },
  "bugs": {
    "url": "https://github.com/jamesfroggatt/antigravitycolorextension/issues"
  },
  "homepage": "https://github.com/jamesfroggatt/antigravitycolorextension#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "color",
    "colour",
    "workspace",
    "window",
    "title bar",
    "titlebar",
    "multiple windows",
    "antigravity",
    "identity"
  ],
  "galleryBanner": {
    "color": "#1E1E1E",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceIdentity",
          "title": "Workspace Identity",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "workspaceIdentity": [
        {
          "type": "webview",
          "id": "workspaceIdentity.panel",
          "name": "Workspace Identity"
        }
      ]
    },
    "commands": [
      {
        "command": "workspaceIdentity.openPanel",
        "title": "Open Panel",
        "category": "Workspace Identity",
        "icon": "$(window)"
      },
      {
        "command": "workspaceIdentity.applyPreset",
        "title": "Apply Preset…",
        "category": "Workspace Identity"
      },
      {
        "command": "workspaceIdentity.reset",
        "title": "Reset Workspace Colours",
        "category": "Workspace Identity"
      }
    ],
    "configuration": {
      "title": "Workspace Identity",
      "properties": {
        "workspaceIdentity.surfaceLightnessMin": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Darkest allowed lightness (%) for the inner surfaces (editor, sidebars, tabs, terminal). Keeps code readable."
        },
        "workspaceIdentity.surfaceLightnessMax": {
          "type": "number",
          "default": 32,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Lightest allowed lightness (%) for the inner surfaces. The default of 32% suits dark themes."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node esbuild.mjs && node test/integration/run.mjs",
    "icon": "node scripts/make-icon.mjs",
    "screenshots": "node esbuild.mjs && node scripts/screenshots/capture.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npm run typecheck && npm test && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
